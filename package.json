{
  "name": "living-earth-observatory",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "check:syntax": "node tools/check-syntax.mjs",
    "check:imports": "node tools/check-import-urls.mjs",
    "validate:registry": "node tools/validate-registry.mjs",
    "check:proxy-node18": "npx -y node@18 --check nasa-proxy-server.js",
