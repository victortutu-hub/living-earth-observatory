# Local-only example for nasa-proxy-server.js.
# Copy this file to .env, then replace the value below with your real key.
# The .env file is ignored by git.
FIRMS_MAP_KEY=your_firms_map_key_here

# The proxy is loopback-only by default. Set HOST explicitly only when the
# deployment environment requires another bind address.
HOST=127.0.0.1
PORT=8787

# Local H.264 conversion (POST /convert-h264) is disabled unless this is exactly 1.
# doar local, nu se setează în cPanel
H264_ENABLED=1

# Local H.264 conversion safety limits. Defaults are used when omitted.
# H264_MAX_INPUT_BYTES=314572800
# H264_MAX_CONCURRENT=1
# H264_TIMEOUT_MS=300000
